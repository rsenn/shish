# ===========================================================================
#
# GNU Makefile for shish/src
#
# relative directories
# ---------------------------------------------------------------------------
srcdir       = @srcdir@
top_srcdir   = @top_srcdir@
builddir     = @builddir@
top_builddir = @top_builddir@
thisdir      = src/

# include global make configuration
# ---------------------------------------------------------------------------
include $(top_builddir)/config.mk

# redirect to recursive targets
# ---------------------------------------------------------------------------
all:              makefiles all-recursive 
clean:            makefiles clean-recursive
distclean:        makefiles distclean-recursive
maintainer-clean: makefiles maintainer-clean-recursive
install:          makefiles install-recursive
dep:              makefiles dep-recursive

# local directory configuration
# ---------------------------------------------------------------------------
RECURSIVE = 1
SUBDIRS   = builtin debug eval exec expand fd fdstack fdtable filter history \
  job parse prompt redir sh source term trace tree var vartab wordlist

PROGRAMS = shish$(EXEEXT) shparse2ast$(EXEEXT) shformat$(EXEEXT)
LIB     = $(top_builddir)/lib/libowfat.a
LDADD   = $(top_builddir)/src/libshell.a \
          $(top_builddir)/text/libtext.a
          
HEADERS = builtin.h debug.h eval.h exec.h expand.h fd.h fdstack.h fdtable.h \
          filter.h history.h job.h parse.h prompt.h redir.h sh.h sig.h \
          source.h term.h trace.h tree.h var.h vartab.h wordlist.h

# local targets     
# ---------------------------------------------------------------------------
all-local: builtin_config.h $(PROGRAMS) 
install-local: install-exec
dep-local:

builtin_config.h:
	cd $(top_builddir) && ./config.status src/builtin_config.sh

sh_main.o: $(srcdir)/sh/sh_main.c
	@$(ECHO_CC)
	@$(COMPILE) -MMD -c -o $@ $<

sh_parse2ast.o: $(srcdir)/sh/sh_parse2ast.c
	@$(ECHO_CC)
	@$(COMPILE) -MMD -c -o $@ $<

sh_parse2ast_debug_begin.o sh_parse2ast_debug_char.o sh_parse2ast_debug_end.o sh_parse2ast_debug_list.o sh_parse2ast_debug_node.o sh_parse2ast_debug_position.o sh_parse2ast_debug_ptr.o sh_parse2ast_debug_redir.o sh_parse2ast_debug_space.o sh_parse2ast_debug_stralloc.o sh_parse2ast_debug_str.o sh_parse2ast_debug_sublist.o sh_parse2ast_debug_subnode.o sh_parse2ast_debug_subst.o sh_parse2ast_debug_ulong.o sh_parse2ast_debug_unquoted.o sh_parse2ast_debug_xlong.o: DEFS += -DSHPARSE2AST=1
sh_parse2ast_debug_begin.o sh_parse2ast_debug_char.o sh_parse2ast_debug_end.o sh_parse2ast_debug_list.o sh_parse2ast_debug_node.o sh_parse2ast_debug_position.o sh_parse2ast_debug_ptr.o sh_parse2ast_debug_redir.o sh_parse2ast_debug_space.o sh_parse2ast_debug_stralloc.o sh_parse2ast_debug_str.o sh_parse2ast_debug_sublist.o sh_parse2ast_debug_subnode.o sh_parse2ast_debug_subst.o sh_parse2ast_debug_ulong.o sh_parse2ast_debug_unquoted.o sh_parse2ast_debug_xlong.o: sh_parse2ast_%.o: $(srcdir)/debug/%.c
	@$(ECHO_CC)
	@$(COMPILE) -MMD -c -o $@ $<

sh_parse2ast_ast_init.o sh_parse2ast_ast_pos.o sh_parse2ast_ast_node.o sh_parse2ast_ast_list.o sh_parse2ast_ast_tree.o sh_parse2ast_ast_ndjson.o sh_parse2ast_ast_names.o: sh_parse2ast_%.o: $(srcdir)/ast/%.c
	@$(ECHO_CC)
	@$(COMPILE) -DSHPARSE2AST=1 -MMD -c -o $@ $<

sh_fmt.o: $(srcdir)/sh/sh_fmt.c
	@$(ECHO_CC)
	@$(COMPILE) -MMD -c -o $@ $<

shish$(EXEEXT):
shish$(EXEEXT): sh_main.o
	$(LINK) -o $@ $< $(PREADD) $(LDADD) $(LIB) $(POSTADD) $(LIBS)

shparse2ast$(EXEEXT):
shparse2ast$(EXEEXT): sh_parse2ast.o sh_parse2ast_ast_init.o sh_parse2ast_ast_pos.o sh_parse2ast_ast_node.o sh_parse2ast_ast_list.o sh_parse2ast_ast_tree.o sh_parse2ast_ast_ndjson.o sh_parse2ast_ast_names.o sh_parse2ast_debug_begin.o sh_parse2ast_debug_char.o sh_parse2ast_debug_end.o sh_parse2ast_debug_list.o sh_parse2ast_debug_node.o sh_parse2ast_debug_position.o sh_parse2ast_debug_ptr.o sh_parse2ast_debug_redir.o sh_parse2ast_debug_space.o sh_parse2ast_debug_stralloc.o sh_parse2ast_debug_str.o sh_parse2ast_debug_sublist.o sh_parse2ast_debug_subnode.o sh_parse2ast_debug_subst.o sh_parse2ast_debug_ulong.o sh_parse2ast_debug_unquoted.o sh_parse2ast_debug_xlong.o
	$(LINK) -o $@ $^ $(LDADD) $(LIB) $(LIBS)

shformat$(EXEEXT):
shformat$(EXEEXT): sh_fmt.o
	$(LINK) -o $@ $^ $(LDADD) $(LIB) $(LIBS)

# installation config
# ---------------------------------------------------------------------------
bin_EXEC += $(PROGRAMS)

# distribution config
# ---------------------------------------------------------------------------
FILES += $(HEADERS) 


#@NO_GLOB@LDADD += $(top_builddir)/lib/glob.o

# local build configuration
# ---------------------------------------------------------------------------
PREADD  = -Wl,--whole-archive
POSTADD = -Wl,--no-whole-archive
INCLUDES += -I$(top_srcdir)/lib -I$(top_builddir)
INCLUDES += -I$(top_builddir) -I$(builddir)

# include build.mk (makefile helper) 
# ---------------------------------------------------------------------------
include $(top_builddir)/build.mk
