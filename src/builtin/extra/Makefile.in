# ===========================================================================
#
# Makefile for src/builtin/extra subdirectory
#
# relative directories
# ---------------------------------------------------------------------------
srcdir       = @srcdir@
top_srcdir   = @top_srcdir@
top_builddir = @top_builddir@
thisdir      = src/builtin/extra/

VPATH        = $(srcdir)

# include global make configuration
# ---------------------------------------------------------------------------
include $(top_builddir)/config.mk

# configuration for this directory
# ---------------------------------------------------------------------------
TL_ARCHIVE = src/libshell.a
ARCHIVE = builtin_extra.a
# only the builtins picked with --enable-builtins are compiled
BUILTINS = @BUILTINS@
MODULES = $(filter $(BUILTINS:%=builtin_%),$(patsubst $(srcdir)/%.c,%,$(wildcard $(srcdir)/builtin_*.c)))

SOURCES = $(MODULES:%=%.c)
OBJECTS = $(MODULES:%=%.o)
DEPS    = $(MODULES:%=%.d)

# targets for this directory
# ---------------------------------------------------------------------------
all: Makefile $(ARCHIVE)
install:

# dependencies
# ---------------------------------------------------------------------------
-include $(DEPS)

# local build configuration
# ---------------------------------------------------------------------------
INCLUDES += -I$(top_srcdir)/lib -I$(top_builddir)
INCLUDES += @IQUOTE_SRC@
INCLUDES += -I$(top_builddir)

# include build.mk (makefile helper)
# ---------------------------------------------------------------------------
include $(top_builddir)/build.mk
