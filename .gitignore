# result artifacts left behind by tests/run-tst.sh / tests/{posix,yash}/run-test.sh
# (tmp.* work dirs are only left behind if a test is killed by SIGKILL, e.g.
# ctest's TIMEOUT firing on a hung testee -- SIGKILL can't be trapped, so
# run-test.sh's own cleanup trap never runs)
tests/posix/*.trs
tests/posix/*.trs.stderr
tests/posix/tmp.*/

# checkfg (tests/checkfg.c) is built straight into tests/posix -- see
# CMakeLists.txt's DO_CONFORMANCE_TESTS block -- since that's where
# the *.tst files' own "../checkfg" reference expects to find it
tests/posix/checkfg
tests/yash/*.trs
tests/yash/*.trs.stderr
tests/yash/tmp.*/

# generated site (tools/site/build.js); published to the gh-pages branch
/docs/
