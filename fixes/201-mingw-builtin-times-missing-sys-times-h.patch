+#if WINDOWS_NATIVE
+static void
+print_filetime(const FILETIME* ft) {
+  ULARGE_INTEGER u;
+
+  u.LowPart = ft->dwLowDateTime;
+  u.HighPart = ft->dwHighDateTime;
+
+  /* FILETIME counts 100ns intervals */
+  print_microsecs((unsigned long)(u.QuadPart / 10));
