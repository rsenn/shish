+/* -i: byte_equal() ignoring ASCII case */
+static int
+grep_equal_i(const char* a, const char* b, size_t n) {
+  for(; n; n--, a++, b++) {
+    int x = (unsigned char)*a, y = (unsigned char)*b;
+
+    if(x >= 'A' && x <= 'Z')
+      x += 'a' - 'A';
+
+    if(y >= 'A' && y <= 'Z')
+      y += 'a' - 'A';
+
+    if(x != y)
+      return 0;
+  }
+
+  return 1;
+}
