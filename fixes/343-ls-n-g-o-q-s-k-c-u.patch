@@ -40,6 +40,13 @@ struct ls_opts {
   unsigned slash : 1;    /* -p */
   unsigned classify : 1; /* -F */
   unsigned inode : 1;    /* -i */
+  unsigned numeric : 1;  /* -n: numeric owner and group (implies -l) */
+  unsigned noowner : 1;  /* -g: no owner column (implies -l) */
