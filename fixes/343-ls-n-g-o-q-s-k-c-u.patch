-    buffer_putspace(fd_out->w);
-    ls_put_group(fd_out->w, (unsigned long)st->st_gid);
-    buffer_putspace(fd_out->w);
+
+    if(!ls_o.noowner) {
+      if(ls_o.numeric)
+        buffer_putulong(fd_out->w, (unsigned long)st->st_uid);
+      else
+        ls_put_user(fd_out->w, (unsigned long)st->st_uid);
+
+      buffer_putspace(fd_out->w);
+    }
+
+    if(!ls_o.nogroup) {
+      if(ls_o.numeric)
+        buffer_putulong(fd_out->w, (unsigned long)st->st_gid);
+      else
+        ls_put_group(fd_out->w, (unsigned long)st->st_gid);
+
+      buffer_putspace(fd_out->w);
+    }
+
     ls_put_size(fd_out->w, (uint64)st->st_size, 6);
     buffer_putspace(fd_out->w);
-    ls_put_time(fd_out->w, st->st_mtime);
+    ls_put_time(fd_out->w, ls_time(st));
     buffer_putspace(fd_out->w);
   }
 
-  buffer_puts(fd_out->w, e->name);
+  if(ls_o.quote) {
+    const char* q;
+
+    for(q = e->name; *q; q++)
+      buffer_putc(fd_out->w, (unsigned char)*q < 32 || *q == 127 ? '?' : *q);
+  } else {
+    buffer_puts(fd_out->w, e->name);
+  }
+
   ls_put_suffix(fd_out->w, st->st_mode);
 
 #ifdef S_ISLNK
