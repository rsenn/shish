   if(!r)
     r = str_diff(x->name, y->name);
@@ -236,22 +249,50 @@ ls_print(const struct ls_ent* e) {
     buffer_putspace(fd_out->w);
   }
 
+  if(ls_o.blocks) {
+    buffer_putulong(fd_out->w, (unsigned long)(((uint64)st->st_blocks + 1) / 2));
+    buffer_putspace(fd_out->w);
+  }
+
   if(ls_o.long_fmt) {
     ls_put_mode(fd_out->w, st->st_mode);
