@@ -5,6 +5,64 @@
 #include "../../lib/shell.h"
 #include "../source.h"
 #include "../exec.h"
+#include "../../lib/alloc.h"
+#include "../../lib/str.h"
+#include "../var.h"
+#include "../../lib/windoze.h"
+#if WINDOWS_NATIVE
+#include <io.h>
+#else
+#include <unistd.h>
+#include <limits.h>
+#endif
+
+#ifndef PATH_MAX
+#define PATH_MAX 4096
+#endif
+
+/* Search PATH for a readable file (for dot/source builtin).
+ * Unlike exec_path, this checks for R_OK not X_OK.
+ * Returns allocated path or NULL. */
+static char*
+source_search_path(const char* name) {
+  const char* vpath;
+  static char path[PATH_MAX];
+  unsigned long si = 0, pi = 0;
+  vpath = var_value("PATH", NULL);
+
+  if(!vpath)
+    return NULL;
+
+  do {
+    unsigned long ni;
+
+    if(vpath[si] == ':')
+      si++;
+
+    ni = str_chr(&vpath[si], ':');
+
+    if(ni >= PATH_MAX) {
+      si += ni;
+      continue;
+    }
+
+    pi = str_copyn(path, &vpath[si], ni);
+
+    if(pi && pi < PATH_MAX - 1)
+      if(path[pi - 1] != '/')
+        path[pi++] = '/';
+
+    str_copyn(&path[pi], name, PATH_MAX - pi - 1);
+
+    /* Check if file is readable (not executable like exec_path) */
+    if(access(path, R_OK) == 0)
+      return str_dup(path);
+
+    si += ni;
+  } while(vpath[si]);
+
+  return NULL;
+}
 
