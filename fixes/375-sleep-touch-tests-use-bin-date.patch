diff --git a/tests/builtin-sleep.sh b/tests/builtin-sleep.sh
index 060fed20..06cc2858 100644
--- a/tests/builtin-sleep.sh
+++ b/tests/builtin-sleep.sh
@@ -8,16 +8,16 @@ sleep 0
 assert_equal "0" "$?" "sleep 0 succeeds"
 
 ## sleep actually suspends execution for roughly the requested time
-START=$(date +%s)
+START=$(/bin/date +%s)
 sleep 1
-END=$(date +%s)
+END=$(/bin/date +%s)
 ELAPSED=$((END - START))
 assert_greater "$ELAPSED" "0" "sleep 1 lets at least a second pass"
 
 ## a fractional value is accepted and actually waits that long
-START=$(date +%s%N)
+START=$(/bin/date +%s%N)
 sleep 0.2
-END=$(date +%s%N)
+END=$(/bin/date +%s%N)
 ELAPSED_MS=$(( (END - START) / 1000000 ))
 assert_greater "$ELAPSED_MS" "100" "sleep 0.2 waits at least 100ms"
 
@@ -25,9 +25,9 @@ assert_greater "$ELAPSED_MS" "100" "sleep 0.2 waits at least 100ms"
 sleep 0.2s
 assert_equal "0" "$?" "sleep accepts an explicit 's' suffix"
 
-START=$(date +%s%N)
+START=$(/bin/date +%s%N)
 sleep 0.01m
-END=$(date +%s%N)
+END=$(/bin/date +%s%N)
 ELAPSED_MS=$(( (END - START) / 1000000 ))
 assert_greater "$ELAPSED_MS" "500" "sleep 0.01m (0.6s) waits at least 500ms"
 
diff --git a/tests/builtin-touch.sh b/tests/builtin-touch.sh
index c8c74ea0..45e47d75 100644
--- a/tests/builtin-touch.sh
+++ b/tests/builtin-touch.sh
@@ -15,13 +15,13 @@ assert_equal "0" "$X" "the file actually exists afterward"
 ## -t sets an explicit [[CC]YY]MMDDhhmm[.ss] stamp
 touch -t 202301021530.45 t1
 X=$(stat -c '%Y' t1)
-EXPECT=$(date -d '2023-01-02 15:30:45' +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S' '2023-01-02 15:30:45' +%s)
+EXPECT=$(/bin/date -d '2023-01-02 15:30:45' +%s 2>/dev/null || /bin/date -j -f '%Y-%m-%d %H:%M:%S' '2023-01-02 15:30:45' +%s)
 assert_equal "$EXPECT" "$X" "-t sets an exact [[CC]YY]MMDDhhmm[.ss] timestamp"
 
 ## -d accepts an ISO date, defaulting the time of day to midnight
 touch -d 2020-05-04 d1
 X=$(stat -c '%Y' d1)
-EXPECT=$(date -d '2020-05-04' +%s 2>/dev/null || date -j -f '%Y-%m-%d' '2020-05-04' +%s)
+EXPECT=$(/bin/date -d '2020-05-04' +%s 2>/dev/null || /bin/date -j -f '%Y-%m-%d' '2020-05-04' +%s)
 assert_equal "$EXPECT" "$X" "-d with a bare date sets midnight of that day"
 
 ## --date=@N sets an exact epoch time
@@ -40,14 +40,14 @@ assert_equal "$Y" "$X" "-r copies the reference file's modification time"
 touch -d 2000-01-01 base
 touch -a -d 2010-01-01 base
 X=$(stat -c '%X %Y' base)
-EXPECT_A=$(date -d '2010-01-01' +%s 2>/dev/null || date -j -f '%Y-%m-%d' '2010-01-01' +%s)
-EXPECT_M=$(date -d '2000-01-01' +%s 2>/dev/null || date -j -f '%Y-%m-%d' '2000-01-01' +%s)
+EXPECT_A=$(/bin/date -d '2010-01-01' +%s 2>/dev/null || /bin/date -j -f '%Y-%m-%d' '2010-01-01' +%s)
+EXPECT_M=$(/bin/date -d '2000-01-01' +%s 2>/dev/null || /bin/date -j -f '%Y-%m-%d' '2000-01-01' +%s)
 assert_equal "$EXPECT_A $EXPECT_M" "$X" "-a updates only the access time"
 
 ## -m changes only the modification time, preserving access time
 touch -m -d 2015-01-01 base
 X=$(stat -c '%X %Y' base)
-EXPECT_M=$(date -d '2015-01-01' +%s 2>/dev/null || date -j -f '%Y-%m-%d' '2015-01-01' +%s)
+EXPECT_M=$(/bin/date -d '2015-01-01' +%s 2>/dev/null || /bin/date -j -f '%Y-%m-%d' '2015-01-01' +%s)
 assert_equal "$EXPECT_A $EXPECT_M" "$X" "-m updates only the modification time"
 
 ## --time=WORD is a synonym for -a / -m; also regression-tests
@@ -57,7 +57,7 @@ assert_equal "$EXPECT_A $EXPECT_M" "$X" "-m updates only the modification time"
 touch -d 2000-01-01 wbase
 touch --time=mtime -d 2011-01-01 wbase
 X=$(stat -c '%Y' wbase)
-EXPECT_M=$(date -d '2011-01-01' +%s 2>/dev/null || date -j -f '%Y-%m-%d' '2011-01-01' +%s)
+EXPECT_M=$(/bin/date -d '2011-01-01' +%s 2>/dev/null || /bin/date -j -f '%Y-%m-%d' '2011-01-01' +%s)
 assert_equal "$EXPECT_M" "$X" "--time=mtime -d survives a preceding removed --time=WORD"
 
 ## -f is accepted and ignored
