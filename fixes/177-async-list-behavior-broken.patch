+           documents this exact fallback). */
+        int rfd = open_read(arg);
+
+        if(rfd == -1) {
+          builtin_error(argv, arg);
+          ret = 1;
+          break;
+        }
+
+        buffer_init(in, (buffer_op_proto*)(void*)&read, rfd, rbuf, sizeof(rbuf));
       }
     }
 
diff --git a/src/eval/eval_simple_command.c b/src/eval/eval_simple_command.c
index 90931532..5729988f 100644
--- a/src/eval/eval_simple_command.c
+++ b/src/eval/eval_simple_command.c
@@ -137,9 +137,41 @@ eval_simple_command(struct eval* e, struct ncmd* ncmd) {
   }
 
   /* do redirections if present */
