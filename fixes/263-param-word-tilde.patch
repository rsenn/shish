+/* param->word may start with a "~"/"~name" that has to resolve against
+ * the live $HOME/passwd db (POSIX 2.6.1) -- but it's part of the
+ * permanent, reused parse tree, so expand_tilde_word()'s in-place splice
+ * must only ever run on a private copy, same as expand_args.c already
+ * does for top-level command arguments. Returns `word` itself when no
+ * copy was needed; pair with expand_param_tilde_free().
+ * ----------------------------------------------------------------------- */
+static union node*
+expand_param_tilde(union node* word) {
+  if(!expand_tilde_needed(word))
+    return word;
+
+  word = tree_copy(word);
+  expand_tilde_word(word);
+  return word;
+}
+
+static void
+expand_param_tilde_free(union node* word, union node* orig) {
+  if(word != orig)
+    tree_free(word);
+}
