diff --git a/cmake/Checks.cmake b/cmake/Checks.cmake
index b47198f2..053154fe 100644
--- a/cmake/Checks.cmake
+++ b/cmake/Checks.cmake
@@ -14,7 +14,9 @@ function(check_cflag FLAG OUTPUT_VAR)
 
   message(CHECK_START "Checking compiler flag ${FLAG}")
   set(CMAKE_REQUIRED_QUIET TRUE)
-  check_c_compiler_flag("${FLAG}" RESULT)
+  string(MAKE_C_IDENTIFIER "CHECK_CFLAG${FLAG}" FLAG_ID)
+  check_c_compiler_flag("${FLAG}" ${FLAG_ID})
+  set(RESULT "${${FLAG_ID}}")
   set(CMAKE_REQUIRED_QUIET FALSE)
 
   #message_func("check_cflag" '${FLAG}' OUTPUT_VAR=${OUTPUT_VAR} VAR_NAME=${VAR_NAME} RESULT=${RESULT})
@@ -22,6 +24,7 @@ function(check_cflag FLAG OUTPUT_VAR)
   if(RESULT)
     message(CHECK_PASS "supported")
     add_cflags("${FLAG}" "${VAR_NAME}")
+    set("${VAR_NAME}" "${${VAR_NAME}}" PARENT_SCOPE)
   else()
     message(CHECK_FAIL "not supported")
   endif()
@@ -357,7 +360,10 @@ macro(check_source_definitions)
     set(SOURCE_TYPES "ATFILE;GNU;LARGEFILE;LARGE_FILE;LARGEFILE64;POSIX;POSIX_C;XOPEN;XOPEN_EXTENDED")
   endif() 
   foreach(TYPE ${SOURCE_TYPES})
-    set_add(SOURCE_DEFINITIONS -D_${TYPE}_SOURCE)
+    # NAME or NAME=VALUE: XOPEN=600 gives -D_XOPEN_SOURCE=600
+    string(REGEX REPLACE "=.*$" "" NAME "${TYPE}")
+    string(REGEX MATCH "=.*$" VALUE "${TYPE}")
+    set_add(SOURCE_DEFINITIONS "-D_${NAME}_SOURCE${VALUE}")
   endforeach()
   add_definitions(${SOURCE_DEFINITIONS})
   list(APPEND CMAKE_REQUIRED_DEFINITIONS ${SOURCE_DEFINITIONS})
@@ -430,16 +436,16 @@ macro(check_fno_optim_flags FLAG_VAR)
   set(FLAGS "-fno-asynchronous-unwind-tables" "-fno-unwind-tables" "-fno-stack-protector" "-fno-jump-tables" "-fno-plt" "-fno-ident" "-fmerge-all-constants" "-ffunction-sections" "-fdata-sections")
 
   foreach(FLAG ${FLAGS})
-    string(MAKE_C_IDENTIFIER "F${FLAG}" FLAG_VAR)
-    check_c_compiler_flag("${FLAG}" ${FLAG_VAR})
-    if(${FLAG_VAR})
-      add_cflags("${FLAG}")
+    string(MAKE_C_IDENTIFIER "F${FLAG}" FLAG_ID)
+    check_c_compiler_flag("${FLAG}" ${FLAG_ID})
+    if(${FLAG_ID})
+      add_cflags("${FLAG}" ${FLAG_VAR})
     endif()
   endforeach()
 
   foreach(FLAG "-Wl,--gc-sections" "-Wl,--as-needed" "-Wl,--build-id=none" "-Wl,-z,norelro" "-Wl,-z,noseparate-code" "-Wl,--hash-style=gnu")
-    string(MAKE_C_IDENTIFIER "LD${FLAG}" FLAG_VAR)
-    check_ldflag("${FLAG}" ${FLAG_VAR})
+    string(MAKE_C_IDENTIFIER "LD${FLAG}" FLAG_ID)
+    check_ldflag("${FLAG}" ${FLAG_ID})
   endforeach()
 endmacro()
 
@@ -925,7 +931,7 @@ function(check_falign_flags)
     set(OUTPUT_VAR CMAKE_C_FLAGS_MINSIZEREL)
   endif()
 
-  set(FLAGS "")
+  set(FLAGS "${${OUTPUT_VAR}}")
 
   check_cflag("-falign-functions=1" F_ALIGN_FUNCTIONS FLAGS)
   check_cflag("-falign-jumps=1" F_ALIGN_JUMPS FLAGS)
@@ -947,6 +953,8 @@ function(check_no_warnings_flags)
     set(OUTPUT_VAR CMAKE_C_FLAGS)
   endif()
 
+  set(FLAGS "${${OUTPUT_VAR}}")
+
   check_cflag("-w" F_NOWARN FLAGS)
 
   if(OUTPUT_VAR)
diff --git a/cmake/Functions.cmake b/cmake/Functions.cmake
index 3d172210..99d53826 100644
--- a/cmake/Functions.cmake
+++ b/cmake/Functions.cmake
@@ -11,18 +11,16 @@ function(add_cflags ADD)
   else()
     set(OUTPUT_VAR "${ARGV1}")
   endif()
-  
-  #message_func("add_cflags" ${ADD} ${OUTPUT_VAR})
 
-  set(RESULT "${${OUTPUT_VAR}}")
-  string(REGEX REPLACE " +" ";" FLAGS "${RESULT}")
-  string(REGEX REPLACE "^;+" "" FLAGS "${FLAGS}")
-  list(REMOVE_DUPLICATES FLAGS) 
+  # space-separated, as CMake wants flag strings: "-a -b", never "-a;-b"
+  separate_arguments(FLAGS UNIX_COMMAND "${${OUTPUT_VAR}}")
+
   if(NOT ADD IN_LIST FLAGS)
-    list(APPEND RESULT ${ADD})
+    list(APPEND FLAGS "${ADD}")
   endif()
 
   if(OUTPUT_VAR)
+    string(REPLACE ";" " " RESULT "${FLAGS}")
     set("${OUTPUT_VAR}" "${RESULT}" PARENT_SCOPE)
   endif()
 endfunction()
