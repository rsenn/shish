@@ -109,9 +114,34 @@ relative_to(stralloc* out, const char* base, const char* target) {
   stralloc_nul(out);
 }
 
+/* does the resolved path meet mode 'e' (it exists) or 'E' (its directory exists)? */
+static int
+realpath_exists(const char* resolved, int mode) {
+  struct stat st;
+  stralloc dir;
+  size_t n = str_len(resolved);
+  int ok;
+
+  if(mode == 'e')
+    return stat(resolved, &st) == 0;
+
+  while(n && resolved[n - 1] != PATHSEP_C)
+    n--;
+
+  if(n <= 1)
+    return 1;
+
+  stralloc_init(&dir);
+  stralloc_copyb(&dir, resolved, n - 1);
+  stralloc_nul(&dir);
+  ok = stat(dir.s, &st) == 0;
+  stralloc_free(&dir);
+  return ok;
+}
+
