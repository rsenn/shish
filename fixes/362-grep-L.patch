+/* -L: the name of the operand just finished, if nothing in it matched */
+static int
+grep_unmatched_line(struct grep* g) {
+  int none = !g->matches;
+
+  g->out.len = 0;
+
+  if(none) {
+    stralloc_cats(&g->out, g->name[0] == '-' && !g->name[1] ? "(standard input)" : g->name);
+    stralloc_catc(&g->out, '\n');
+  }
+
+  g->matches = 0;
+  g->pending = 0;
+  return none;
+}
