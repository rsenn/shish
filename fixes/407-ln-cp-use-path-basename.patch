+case $(command -V ln 2>&1) in
+  *"built-in"*)
+    LDIR=$(mktemp -d)
+    mkdir "$LDIR/src" "$LDIR/dst"
+    (cd "$LDIR" && ln -s "$LDIR/src/" dst)
+    assert_equal "src" "$(ls "$LDIR/dst")" "ln names the link after the basename of a source with a trailing separator"
+    rm -rf "$LDIR"
+    ;;
+esac
