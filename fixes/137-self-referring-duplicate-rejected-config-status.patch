diff --git a/src/redir/redir_eval.c b/src/redir/redir_eval.c
index 597a4fd1..98a6973b 100644
--- a/src/redir/redir_eval.c
+++ b/src/redir/redir_eval.c
@@ -31,8 +31,60 @@ redir_eval(struct nredir* nredir, struct fd* d, int rfl) {
