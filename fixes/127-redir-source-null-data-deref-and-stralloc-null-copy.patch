diff --git a/lib/stralloc/stralloc_catb.c b/lib/stralloc/stralloc_catb.c
index a529c8b2..894ae9c6 100644
--- a/lib/stralloc/stralloc_catb.c
+++ b/lib/stralloc/stralloc_catb.c
@@ -9,7 +9,13 @@
 int
 stralloc_catb(stralloc* sa, const char* buf, size_t len) {
   if(stralloc_readyplus(sa, len)) {
-    byte_copy(sa->s + sa->len, len, buf);
+    /* byte_copy() is memcpy() (lib/byte.h), whose "buf" argument carries
+     * a nonnull attribute even at len == 0 -- an empty/unset stralloc
+     * (buf == NULL, len == 0) is a real, common caller here (e.g. a
+     * command substitution with no output), so skip the call rather
+     * than pass a null pointer through it. */
+    if(len)
+      byte_copy(sa->s + sa->len, len, buf);
     sa->len += len;
     return 1;
   }
diff --git a/lib/stralloc/stralloc_copyb.c b/lib/stralloc/stralloc_copyb.c
index ea336879..5dcc3160 100644
--- a/lib/stralloc/stralloc_copyb.c
+++ b/lib/stralloc/stralloc_copyb.c
@@ -8,7 +8,13 @@ int
 stralloc_copyb(stralloc* sa, const char* buf, size_t len) {
   if(stralloc_ready(sa, len)) {
     sa->len = len;
-    byte_copy(sa->s, len, buf);
+    /* byte_copy() is memcpy() (lib/byte.h), whose "buf" argument carries
+     * a nonnull attribute even at len == 0 -- an empty/unset stralloc
+     * (buf == NULL, len == 0) is a real, common caller here (e.g. a
+     * command substitution with no output), so skip the call rather
+     * than pass a null pointer through it. */
+    if(len)
+      byte_copy(sa->s, len, buf);
     return 1;
   }
   return 0;
