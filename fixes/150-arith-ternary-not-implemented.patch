diff --git a/src/expand/expand_arith_ternary.c b/src/expand/expand_arith_ternary.c
new file mode 100644
index 00000000..7342f195
--- /dev/null
+++ b/src/expand/expand_arith_ternary.c
@@ -0,0 +1,17 @@
+#include "../expand.h"
+#include "../tree.h"
+
+/* expand a ternary ("?:") expression
+ * ----------------------------------------------------------------------- */
+int
+expand_arith_ternary(struct narithternary* expr, int64* r) {
+  int64 cond;
+
+  if(expand_arith_expr(expr->cond, &cond))
+    return 1;
+
+  /* only the taken branch is evaluated -- the other one can have side
+     effects (assignments) that must not run, same rule as "&&"/"||"
+     in expand_arith_binary.c. */
+  return expand_arith_expr(cond ? expr->ontrue : expr->onfalse, r);
+}
diff --git a/src/parse/parse_arith_ternary.c b/src/parse/parse_arith_ternary.c
new file mode 100644
index 00000000..01114a32
--- /dev/null
+++ b/src/parse/parse_arith_ternary.c
@@ -0,0 +1,47 @@
+#include "../parse.h"
+#include "../source.h"
+#include "../tree.h"
+
+/* parse arithmetic conditional ("?:") expression
+ * ----------------------------------------------------------------------- */
+union node*
+parse_arith_ternary(struct parser* p) {
+  union node *cond, *ontrue, *onfalse, *node;
+  char c;
+
+  if((cond = parse_arith_binary(p, ARITH_PREC_TOP)) == NULL)
+    return NULL;
+
+  parse_skipspace(p);
+
+  if(source_peek(&c) <= 0 || c != '?')
+    return cond;
+
+  parse_skip(p);
+  parse_skipspace(p);
+
+  /* the true-branch is a full expression (POSIX grammar allows
+     assignments in it, e.g. "1 ? a = 2 : 3"), while the false-branch
+     recurses back into parse_arith_ternary() itself so chained
+     conditionals ("a?b:c?d:e") associate right-to-left like C. */
+  if((ontrue = parse_arith_expr(p)) == NULL)
+    return NULL;
+
+  parse_skipspace(p);
+
+  if(source_peek(&c) <= 0 || c != ':')
+    return NULL;
+
+  parse_skip(p);
+  parse_skipspace(p);
+
+  if((onfalse = parse_arith_ternary(p)) == NULL)
+    return NULL;
+
+  node = tree_newnode(A_TERNARY);
+  node->narithternary.cond = cond;
+  node->narithternary.ontrue = ontrue;
+  node->narithternary.onfalse = onfalse;
+
+  return node;
+}
