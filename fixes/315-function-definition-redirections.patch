diff --git a/src/parse/parse_function.c b/src/parse/parse_function.c
index 66c5a8d3..5a466e49 100644
--- a/src/parse/parse_function.c
+++ b/src/parse/parse_function.c
@@ -68,6 +68,19 @@ parse_function(struct parser* p) {
     }
   }
 
+  /* redirections after the body apply on every call: f() { ...; } >file */
+  {
+    union node** rptr = &node->nfunc.body->ncmd.rdir;
+
+    while(*rptr)
+      tree_skip(rptr);
+
+    while(parse_gettok(p, P_DEFAULT) & T_REDIR)
+      tree_move(p->tree, rptr);
+
+    p->pushback++;
+  }
+
   node->nfunc.loc = loc;
 
   TRACE(TRACE_PARSE, "function", trace_str("name", node->nfunc.name));
diff --git a/src/tree/tree_copy.c b/src/tree/tree_copy.c
index fa1eee49..d84e506a 100644
--- a/src/tree/tree_copy.c
+++ b/src/tree/tree_copy.c
@@ -30,6 +30,18 @@ tree_copy(union node* node) {
     byte_copy(copy, tree_nodesizes[node->id], node);
     copy->next = NULL;
 
+    /* a compound command's redirections (f() { ...; } >file) */
+    switch(node->id) {
+      case N_SUBSHELL:
+      case N_BRACEGROUP:
+      case N_FOR:
+      case N_CASE:
+      case N_IF:
+      case N_WHILE:
+      case N_UNTIL: copy->ncmd.rdir = node->ncmd.rdir ? tree_copy(node->ncmd.rdir) : NULL; break;
+      default: break;
+    }
+
     switch(node->id) {
       case N_SIMPLECMD:
         copy->ncmd.rdir = node->ncmd.rdir ? tree_copy(node->ncmd.rdir) : NULL;
