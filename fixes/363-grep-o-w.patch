+/* leftmost-longest match at or after from: 1 and *st, *en, or 0 */
+static int
+grep_find(struct grep* g, const char* line, size_t len, size_t from, size_t* st, size_t* en) {
+  if(g->fixed) {
+    size_t i;
+
+    for(i = from; i <= len; i++) {
+      const char* pat = g->fixed_pat;
+      int hit = 0;
+      size_t best = 0;
+
+      for(;;) {
+        size_t n = str_chr(pat, '\n');
+
+        if(n <= len - i && (!hit || n > best) && (g->icase ? grep_equal_i(line + i, pat, n) : byte_equal(line + i, n, pat)))
+          hit = 1, best = n;
+
+        if(!pat[n])
+          break;
+
+        pat += n + 1;
+      }
+
+      if(hit) {
+        *st = i;
+        *en = i + best;
+        return 1;
+      }
+    }
+
+    return 0;
+  }
+
+#if GREP_USE_SYSTEM_REGEX
+  {
+    char* z = alloc(len + 1);
+    regmatch_t pm;
+    int m;
+
+    byte_copy(z, len, line);
+    z[len] = '\0';
+    m = regexec(&g->re, z + from, 1, &pm, from ? REG_NOTBOL : 0) == 0;
+    alloc_free(z);
+
+    if(m) {
+      *st = from + (size_t)pm.rm_so;
+      *en = from + (size_t)pm.rm_eo;
+    }
+
+    return m;
+  }
+#else
+  {
+    struct dfa_span m;
+
+    if(!dfa_search(&g->re, line, len, from, &m))
+      return 0;
+
+    *st = m.start;
+    *en = m.end;
+    return 1;
+  }
+#endif
+}
+
+static int
+grep_wordch(int c) {
+  return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
+}
+
+/* -w: the next match at or after from with no word character on either side */
+static int
+grep_find_word(struct grep* g, const char* line, size_t len, size_t from, size_t* st, size_t* en) {
+  while(from <= len && grep_find(g, line, len, from, st, en)) {
+    if((!*st || !grep_wordch((unsigned char)line[*st - 1])) && (*en == len || !grep_wordch((unsigned char)line[*en])))
+      return 1;
+
+    from = *st + 1;
+  }
+
+  return 0;
+}
