+      char drain[64];
+
+      while(read(job_sigfd[0], drain, sizeof(drain)) > 0)
+        ;
+
+      term_jobnotify();
+
+      if(!FD_ISSET(term_input.fd, &rfds))
+        continue;
+    }
+
+    return;
+  }
+}
