+/* -F: does any '\n'-separated string of the pattern occur in line? "" matches everything */
+static int
+grep_test_fixed(const char* pat, const char* line, size_t len) {
+  for(;;) {
+    size_t n = str_chr(pat, '\n'), i;
+
+    if(n <= len)
+      for(i = 0; i + n <= len; i++)
+        if(byte_equal(line + i, n, pat))
+          return 1;
+
+    if(!pat[n])
+      return 0;
+
+    pat += n + 1;
+  }
+}
